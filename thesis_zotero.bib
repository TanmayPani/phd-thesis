@misc{cheslerJetQuenchingStrongly2014,
  title = {Jet Quenching in Strongly Coupled Plasma},
  author = {Chesler, Paul M. and Rajagopal, Krishna},
  year = 2014,
  month = feb,
  journal = {arXiv.org},
  doi = {10.1103/PhysRevD.90.025033},
  urldate = {2026-10-01},
  abstract = {We present calculations in which an energetic light quark shoots through a finite slab of strongly coupled \$\textbraceleft\textbackslash cal N\textbraceright =4\$ supersymmetric Yang-Mills (SYM) plasma, with thickness \$L\$, focussing on what comes out on the other side. We find that even when the "jets" that emerge from the plasma have lost a substantial fraction of their energy they look in almost all respects like "jets" in vacuum with the same reduced energy. The one possible exception is that the opening angle of the "jet" is larger after passage through the slab of plasma than before. Along the way, we obtain a fully geometric characterization of energy loss in the strongly coupled plasma and show that \$dE\_\textbraceleft\textbackslash rm out\textbraceright/dL \textbackslash propto L\textasciicircum 2/\textbackslash sqrt\textbraceleft x\textasciicircum 2\_\textbraceleft\textbackslash rm stop\textbraceright -L\textasciicircum 2\textbraceright\$, where \$E\_\textbraceleft\textbackslash rm out\textbraceright\$ is the energy of the "jet" that emerges from the slab of plasma and \$x\_\textbraceleft\textbackslash rm stop\textbraceright\$ is the (previously known) stopping distance for the light quark in an infinite volume of plasma.},
  howpublished = {https://arxiv.org/abs/1402.6756v1},
  langid = {english},
  file = {/home/tanmaypani/Zotero/storage/5JP3F5G8/Chesler and Rajagopal - 2014 - Jet quenching in strongly coupled plasma.pdf}
}

@article{chienCollinearDrop2020,
  title = {Collinear Drop},
  author = {Chien, Yang-Ting and Stewart, Iain W.},
  year = 2020,
  month = jun,
  journal = {J. High Energ. Phys.},
  volume = {2020},
  number = {6},
  pages = {64},
  issn = {1029-8479},
  doi = {10.1007/JHEP06(2020)064},
  urldate = {2026-09-29},
  abstract = {We introduce collinear drop jet substructure observables, which are unaffected by contributions from collinear radiation, and systematically probe soft radiation within jets. These observables can be designed to be either sensitive or insensitive to process-dependent soft radiation originating from outside the jet. Such collinear drop observables can be exploited as variables to distinguish quark, gluon, and color neutral initiated jets, for testing predictions for perturbative soft radiation in Monte Carlo simulations, for assessing models and universality for hadronization corrections, for examining the efficiency of pileup subtraction methods, and for any other application that leaves an imprint on soft radiation. We discuss examples of collinear drop observables that are based both on clustering and on jet shapes. Using the soft-collinear effective theory we derive factorization expressions for collinear drop observables from QCD jets, and carry out a resummation of logarithmically enhanced contributions at next-to-leading-logarithmic order. We also identify an infinite class of collinear drop observables for which the leading double logarithms are absent.},
  langid = {english},
  keywords = {Jets,QCD Phenomenology},
  file = {/home/tanmaypani/Zotero/storage/XE7W4ISG/Chien and Stewart - 2020 - Collinear drop.pdf}
}

