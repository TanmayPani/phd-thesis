@incollection{paniGeneralizedAngularitiesDifferential2024,
  title = {Generalized Angularities and Differential Jet Shapes Measurements from {{STAR}} at \$\textbackslash sqrt\textbraceleft s\textbraceright{} = \$ 200 {{GeV}}},
  booktitle = {Proceedings of 11th {{International Conference}} on {{Hard}} and {{Elecctromagnetic Probes}} of {{High-Energy Nuclear Collisions}} --- {{PoS}}({{HardProbes2023}})},
  author = {Pani, Tanmay},
  year = 2024,
  month = feb,
  volume = {438},
  pages = {172},
  publisher = {SISSA Medialab},
  doi = {10.22323/1.438.0172},
  urldate = {2026-09-29},
  abstract = {Jets from early stages of heavy-ion collisions undergo modified showering in quark-gluon plasma (QGP) relative to vacuum due to jet-medium interactions, which can be measured using observables like differential jet shape and generalized angularities. Differential jet shape (\textbackslash (\textbackslash rho(\textbackslash mathbf\textbraceleft r\textbraceright )\textbackslash ) ) encodes radially differential information about jet broadening and has shown an average migration of charged energy away from the axes of quenched jets from Pb+Pb collisions at the LHC. Measurements of generalized angularities in presence of the medium from Pb+Pb collisions at the LHC show harder, or more quark-like jet fragmentation relative to vacuum. Measuring these distributions in heavy-ion collisions at RHIC will help us further characterize jet-medium interactions in a phase-space region complementary to that of the LHC. In these proceedings, we present the first fully corrected measurements of (\textbackslash (\textbackslash rho(\textbackslash mathbf\textbraceleft r\textbraceright )\textbackslash )) , jet girth (g), momentum dispersion (\textbackslash (\textbackslash rm p\_T\textasciicircum D\textbackslash )) and momentum difference of leading and subleading constituent particles (LeSub) observables, using hard-core jets in p + p collisions at \textbackslash (\textbackslash sqrt\textbraceleft s\textbraceright{} = 200\textbackslash{} \textbackslash mathrm\textbraceleft GeV\textbraceright\textbackslash ), collected by the STAR experiment. Finally, the data are compared with model calculations and the physics implications are discussed.},
  langid = {english},
  file = {/home/tanmaypani/Zotero/storage/8FPMP4FK/Pani - 2024 - Generalized angularities and differential jet shapes measurements from STAR at $sqrt s = $ 200 GeV.pdf}
}

@article{paniGeneralizedAngularitiesMeasurements2024,
  title = {Generalized Angularities Measurements from {{STAR}} at \textsurd{{SNN}} = 200 {{GeV}}},
  author = {Pani, Tanmay},
  year = 2024,
  journal = {EPJ Web Conf.},
  volume = {296},
