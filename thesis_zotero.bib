  keywords = {Nuclear Experiment},
  file = {/home/tanmaypani/Zotero/storage/QGQ8A2UD/Adare et al. - 2015 - An Upgrade Proposal from the PHENIX Collaboration.pdf;/home/tanmaypani/Zotero/storage/V46QSQ2E/1501.html}
