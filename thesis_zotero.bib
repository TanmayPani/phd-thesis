@misc{bossiMeasurementEnergyenergyCorrelator2025,
  title = {Measurement of the Energy-Energy Correlator in the Back-to-Back Limit Using the Archived {{ALEPH}} \$e\textasciicircum\textbraceleft +\textbraceright e\textasciicircum\textbraceleft -\textbraceright\$ Data at 91.2 {{GeV}}},
  author = {Bossi, Hannah and Baty, Austin and Chen, Yi and Chen, Yu-Chen and Innocenti, Gian-Michele and Maggi, Marcello and McGinn, Chris and Lee, Yen-Jie},
  year = 2025,
