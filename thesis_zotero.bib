  primaryclass = {hep-ex},
  pages = {212002},
  issn = {0031-9007, 1079-7114},
  doi = {10.1103/PhysRevLett.123.212002},
  urldate = {2026-10-01},
  abstract = {Measurements of two-particle angular correlations of charged particles emitted in hadronic \$Z\$ decays are presented. The archived \$e\textasciicircum +e\textasciicircum -\$ annihilation data at a center-of-mass energy of 91 GeV were collected with the ALEPH detector at LEP between 1992 and 1995. The correlation functions are measured over a broad range of pseudorapidity and full azimuth as a function of charged particle multiplicity. No significant long-range correlation is observed in either the lab coordinate analysis or the thrust coordinate analysis, where the latter is sensitive to a medium expanding transverse to the color string between the outgoing \$q\textbackslash bar\textbraceleft q\textbraceright\$ pair from \$Z\$ boson decays. The associated yield distributions in both analyses are in better agreement with the prediction from the PYTHIA v6.1 event generator than from HERWIG v7.1.5. They provide new insights to showering and hadronization modeling. These results serve as an important reference to the observed long-range correlation in proton-proton, proton-nucleus, and nucleus-nucleus collisions.},
  archiveprefix = {arXiv},
  keywords = {High Energy Physics - Experiment},
  file = {/home/tanmaypani/Zotero/storage/M6XWD2FB/Badea et al. - 2019 - Measurements of two-particle correlations in $e^+e^-$ collisions at 91 GeV with ALEPH archived data.pdf;/home/tanmaypani/Zotero/storage/IIZCQN9V/1906.html}
}

