  number = {1},
  pages = {12},
  title = {Signatures of QGP at RHIC and the LHC},
  url = {https://doi.org/10.1007/s43673-021-00014-3},
  volume = {31},
  year = {2021},
  bdsk-url-1 = {https://doi.org/10.1007/s43673-021-00014-3},
}

